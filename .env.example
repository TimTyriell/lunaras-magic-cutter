# Copy to .env (gitignored) and adjust. Real environment variables override this file.

# Folder that contains the transcript repo (pnp-crawl/) and the knowledge bundle (pnp-knowledge/). Read-only sources.
PNP_ROOT=C:\path\to\pnp-repos

# Python 3.11 interpreter with faster-whisper and yt-dlp installed. Scripts are run with it.
PY=C:\path\to\venv\Scripts\python.exe

# Optional: yt-dlp executable (default: yt-dlp.exe next to PY, else "yt-dlp" on PATH).
# YTDLP=

# Optional: browser to read YouTube cookies from when config/cookies.txt is absent (default: firefox).
# YTDLP_BROWSER=firefox
